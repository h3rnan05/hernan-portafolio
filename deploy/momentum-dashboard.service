[Unit]
Description=Genera el panel del bot (solo lectura)

[Service]
Type=oneshot
# Mismo usuario, carpeta y variables que momentum-watchlist.service:
# así lee /var/lib/momentum (0750) y las llaves ALPACA_PAPER_* de paper.env.
User=momentum
Group=momentum
WorkingDirectory=/opt/hernan-portafolio
Environment=PYTHONPATH=/opt/hernan-portafolio
EnvironmentFile=/etc/momentum/paper.env
Environment=DASH_SALIDA=/var/lib/momentum/dashboard_site
Environment=DASH_TZ=America/Monterrey
# Caché de velas de 1 min (dashboard/velas.py): fuera de git, junto al HTML.
# Sin esta variable el panel usa el temporal del sistema, nunca el repo.
Environment=DASH_CACHE_VELAS=/var/lib/momentum/dashboard_cache
ExecStart=/opt/hernan-portafolio/.venv/bin/python -m dashboard.build_dashboard
