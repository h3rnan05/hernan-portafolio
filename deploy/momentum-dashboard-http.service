[Unit]
Description=Sirve el panel solo en localhost (se abre por túnel SSH)
After=network.target

[Service]
User=momentum
Group=momentum
ExecStart=/usr/bin/python3 -m http.server 8787 --bind 127.0.0.1 --directory /var/lib/momentum/dashboard_site
Restart=on-failure

[Install]
WantedBy=multi-user.target
