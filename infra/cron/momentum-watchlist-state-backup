# PAPER ONLY. Backup diario del overlay VPS.
# Condición Claude #1. No arranca momentum-watchlist.timer.
# Instalar post-merge (ops): sudo mkdir -p /var/backups/momentum && \
#   sudo chown momentum:momentum /var/backups/momentum && \
#   sudo crontab -u momentum infra/cron/momentum-watchlist-state-backup
CRON_TZ=America/Monterrey
15 2 * * * [ -f /var/lib/momentum/watchlist_vps_state.json ] && cp -a /var/lib/momentum/watchlist_vps_state.json /var/backups/momentum/watchlist_vps_state-$(date +\%F).json; find /var/backups/momentum -name 'watchlist_vps_state-*.json' -mtime +14 -delete
