[Unit]
Description=Timer del escaneo completo en el VPS (cada 30 min, Lun-Vie 13-20 UTC)
Requires=momentum-scan.service

[Timer]
# :01:20 y :31:20. El pre-pull no puede seguir vivo a los :05: el vigía
# escribe estado en ese segundo y, si cae entre el stash y el pop, el
# pop aborta (2026-09-28). El segundo 20 queda después de ese tick y
# antes del siguiente. El slot del universo se deriva del reloj en tramos
# de 30 min: 20 s no cambian qué se escanea. Persistent=false a propósito:
# un escaneo atrasado no sirve, la ventana ya pasó.
OnCalendar=Mon..Fri *-*-* 13..20:01,31:20 UTC
Persistent=false
Unit=momentum-scan.service

[Install]
WantedBy=timers.target
